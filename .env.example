# API
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://remarket:remarket@localhost:5432/remarket
# Persistent API: opt into the configured DIRECT_URL/session pool (not serverless).
DATABASE_USE_DIRECT_URL=false
DATABASE_CONNECTION_LIMIT=5
# Separate bounded pool for jobs and realtime relay; total per API = 5 + 1.
BACKGROUND_DATABASE_CONNECTION_LIMIT=1
# BACKGROUND_DATABASE_URL defaults to the selected API connection URL.
DATABASE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_TRANSACTION_MAX_WAIT_MS=10000
DATABASE_HEALTH_TIMEOUT_MS=10000
DIRECT_URL=postgresql://remarket:remarket@localhost:5432/remarket
# Disposable database used only by the PostgreSQL integration suite.
TEST_DATABASE_URL=postgresql://remarket:remarket@localhost:5432/remarket_test
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=remarket
JWT_AUDIENCE=remarket-web
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
WEB_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
BCRYPT_COST=12
ORDER_CONFIRM_TIMEOUT_HOURS=24
STORAGE_DRIVER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
STORAGE_BUCKET=remarket-private
STORAGE_SIGNED_URL_TTL_SECONDS=300
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=no-reply@example.com
COOKIE_SECURE=auto
RUN_JOBS=auto
WORKER_INTERVAL_MS=60000
OUTBOX_INTERVAL_MS=1000

# Web
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000
