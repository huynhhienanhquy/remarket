# Existing HTTPS backend used by the web app. Works across Wi-Fi networks.
EXPO_PUBLIC_API_BASE_URL=https://remarket-vytf.onrender.com/api/v1
EXPO_PUBLIC_SOCKET_URL=https://remarket-vytf.onrender.com
# For a local API, replace both URLs with your computer's LAN address.
# Set after linking an EAS project. Leave empty to develop without remote push.
EXPO_PUBLIC_EAS_PROJECT_ID=
