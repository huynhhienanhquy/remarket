{
  "name": "@remarket/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "go": "expo start --go --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "doctor": "expo-doctor",
    "build:preview": "pnpm dlx eas-cli build --profile preview --platform all",
    "build:development": "pnpm dlx eas-cli build --profile development --platform all"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@remarket/api-client": "workspace:*",
    "@remarket/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "expo": "~57.0.29",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-worklets": "0.10.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react-dom": "~19.2.0",
    "@eslint/js": "^9.17.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "expo-doctor": "^1.17.0",
    "globals": "^15.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  }
