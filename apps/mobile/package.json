{
  "name": "@remarket/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "go": "expo start --go --lan",
    "go:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "doctor": "expo-doctor",
    "build:preview": "pnpm dlx eas-cli build --profile preview --platform all",
    "build:development": "pnpm dlx eas-cli build --profile development --platform all"
  },
  "dependencies": {
    "@copilotkit/react-native": "1.85.0",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@remarket/api-client": "workspace:*",
    "@remarket/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "base64-js": "1.5.1",
    "expo": "58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-worklets": "0.13.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "socket.io-client": "4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react-dom": "~19.3.0",
    "@eslint/js": "^9.17.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "expo-doctor": "^1.17.0",
    "globals": "^15.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  }
}
